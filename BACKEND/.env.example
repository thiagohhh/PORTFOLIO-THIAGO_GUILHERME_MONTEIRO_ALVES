# Chave privada usada para assinar tokens JWT; gere um valor longo e aleatorio.
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# URL de conexao do PostgreSQL usado pelo backend.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# URL do projeto Supabase, usado pelo backend para guardar arquivos.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role do Supabase; mantenha como Secret e somente no backend.
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_CHAVE_SECRETA_AQUI

# Nome do bucket publico criado no Supabase Storage.
SUPABASE_STORAGE_BUCKET=portfolio-media

# Dados para criar o administrador inicial; opcionais.
USER_NAME=
USER_EMAIL=
USER_PASSWORD=
