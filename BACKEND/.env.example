# Configuracao para executar com MySQL local (banco independente).
JWT_SECRET=crie-uma-chave-local-longa

DB_NAME=portifolio_senaiEsesi
DB_USER=root
DB_PASSWORD=coloque-sua-senha-do-mysql
DB_HOST=localhost

# Administrador inicial criado somente se o banco local estiver sem alunos.
USER_NAME=Administrador Local
USER_EMAIL=admin@local.test
USER_PASSWORD=crie-uma-senha

# Opcional: Supabase Storage para recursos que utilizam upload de arquivos.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_CHAVE_SECRETA_AQUI
# SUPABASE_STORAGE_BUCKET=portfolio-media

# Para usar PostgreSQL em vez de MySQL, configure DATABASE_URL.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
